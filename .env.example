# Copy to .env and fill in. Never commit .env.

# Public access (a Cloudflare tunnel and your own domain) is set up from the dashboard:
# on first sign-in, or later under Settings. Nothing about it goes in this file.
# Until then, apps are served on this machine only, at http://<name>.localhost:8080.

# Dashboard password. Dockyard can run anything on this machine, so treat it like root.
ADMIN_PASSWORD=

# Encrypts stored secrets and signs sessions. Generate with: openssl rand -hex 32
DOCKYARD_SECRET=

# Optional: registry credentials for pulling private images. It is easier to add these on the
# dashboard's Settings page; values saved there take priority over the ones below.
# Docker Hub:
# DOCKERHUB_USERNAME=
# DOCKERHUB_TOKEN=

# GitHub Container Registry (a personal access token (classic) with the read:packages scope):
# GHCR_USERNAME=
# GHCR_TOKEN=

# Optional: seconds to wait for containers to become running/healthy on deploy.
# DEPLOY_WAIT_TIMEOUT=120

# Optional: where the local addresses are served. LOCAL_BIND=0.0.0.0 also exposes them
# to other machines on your network.
# LOCAL_PORT=8080
# LOCAL_BIND=127.0.0.1
