# Copy to .env and fill in. Never commit .env.

# Apps get <random-slug>.BASE_DOMAIN; the dashboard lives at DASHBOARD_HOST.
BASE_DOMAIN=example.com
DASHBOARD_HOST=dockyard.example.com

# Token from Cloudflare Zero Trust > Networks > Tunnels (see README).
CLOUDFLARE_TUNNEL_TOKEN=

# Dashboard password. Dockyard can run anything on this machine, so treat it like root.
ADMIN_PASSWORD=

# Encrypts stored secrets and signs sessions. Generate with: openssl rand -hex 32
DOCKYARD_SECRET=

# Optional: Docker Hub credentials for pulling private images.
# DOCKERHUB_USERNAME=
# DOCKERHUB_TOKEN=

# Optional: seconds to wait for containers to become running/healthy on deploy.
# DEPLOY_WAIT_TIMEOUT=120
